# ─────────────────────────────────────────────────────────────
# TZW FEMS — environment configuration
# Copy to `.env` (never commit the real .env)
# ─────────────────────────────────────────────────────────────

NODE_ENV=development

# ── Database ──────────────────────────────────────────────────
POSTGRES_USER=tzw
POSTGRES_PASSWORD=tzw_secret_change_me
POSTGRES_DB=fems
# Inside docker-compose the host is the service name `postgres`.
# For local (non-docker) dev use localhost.
DATABASE_URL=postgresql://tzw:tzw_secret_change_me@postgres:5432/fems?schema=public

# ── JWT ───────────────────────────────────────────────────────
JWT_ACCESS_SECRET=replace_with_long_random_string_access
JWT_REFRESH_SECRET=replace_with_long_random_string_refresh
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# ── Service ports ─────────────────────────────────────────────
GATEWAY_PORT=8080
AUTH_PORT=4001
USER_PORT=4002
EXTINGUISHER_PORT=4003
INSPECTION_PORT=4004
MAINTENANCE_PORT=4005
REPORTING_PORT=4006
NOTIFICATION_PORT=4007

# ── Internal service URLs (used by the gateway) ───────────────
AUTH_SERVICE_URL=http://auth-service:4001
USER_SERVICE_URL=http://user-service:4002
EXTINGUISHER_SERVICE_URL=http://extinguisher-service:4003
INSPECTION_SERVICE_URL=http://inspection-service:4004
MAINTENANCE_SERVICE_URL=http://maintenance-service:4005
REPORTING_SERVICE_URL=http://reporting-service:4006
NOTIFICATION_SERVICE_URL=http://notification-service:4007

# ── CORS / frontend ───────────────────────────────────────────
CORS_ORIGIN=http://localhost:5173
VITE_API_URL=http://localhost:8080/api

# ── Mail (notification-service) ───────────────────────────────
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=
SMTP_PASS=
MAIL_FROM="TZW FEMS <no-reply@tzw.com>"

# ── Rate limiting ─────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
